<Page x:Class="InfoSecurity.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Width="540" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SecondBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Регистрация пользователя" FontSize="22" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,0,0,16"/>
                <Label Content="Фамилия, имя, отчество"/>
                <TextBox x:Name="TxtFio" Tag="Например: Иванов Иван Иванович" MaxLength="150"
                         Style="{StaticResource HintTextBoxStyle}" ToolTip="Допускаются буквы, пробелы и дефис"
                         PreviewTextInput="TxtFio_PreviewTextInput"/>
                <Label Content="Логин"/>
                <TextBox x:Name="TxtLogin" Tag="Английские буквы и цифры" MaxLength="50"
                         Style="{StaticResource HintTextBoxStyle}" ToolTip="Логин без пробелов и специальных символов"
                         PreviewTextInput="TxtLogin_PreviewTextInput"/>
                <Label Content="Пароль"/>
                <PasswordBox x:Name="PassFirst" Tag="Не менее 6 символов и одна цифра"
                             Style="{StaticResource HintPasswordBoxStyle}" ToolTip="Только английские буквы и цифры"/>
                <Label Content="Подтверждение пароля"/>
                <PasswordBox x:Name="PassSecond" Tag="Повторите пароль"
                             Style="{StaticResource HintPasswordBoxStyle}" ToolTip="Значения паролей должны совпадать"/>
                <TextBlock Text="Новой учётной записи назначается роль «Пользователь». Права администратора назначает ответственный сотрудник."
                           Margin="4,10" Foreground="{DynamicResource HintBrush}"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Зарегистрироваться" ToolTip="Проверить данные и создать учётную запись" Click="Register_Click"/>
                    <Button Content="Отмена" ToolTip="Вернуться к авторизации" Click="Cancel_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
