<Page x:Class="InfoSecurity.Pages.TablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица">
    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" Margin="5"/>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBox x:Name="SearchBox" Tag="Поиск по всем столбцам" Width="210"
                     Style="{StaticResource HintTextBoxStyle}" ToolTip="Поиск по всем отображаемым значениям"
                     TextChanged="Filter_Changed"/>
            <ComboBox x:Name="FilterCombo" Width="170" ToolTip="Фильтр по характерному полю" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortCombo" Width="180" ToolTip="Сортировка по выбранному столбцу" SelectionChanged="Filter_Changed"/>
            <Button Content="Сбросить" ToolTip="Очистить поиск, фильтр и сортировку" Click="ClearFilters_Click"/>
            <Button Content="Добавить" ToolTip="Добавить новую запись" Click="Add_Click"/>
            <Button Content="Изменить" ToolTip="Редактировать выбранную запись" Click="Edit_Click"/>
            <Button Content="Удалить" ToolTip="Удалить выбранные записи с подтверждением" Click="Delete_Click"/>
            <Button Content="Обновить" ToolTip="Повторно загрузить данные" Click="Refresh_Click"/>
        </WrapPanel>
        <DataGrid x:Name="DataGrid" Grid.Row="2" MouseDoubleClick="DataGrid_MouseDoubleClick"
                  ToolTip="Двойной щелчок открывает выбранную запись для редактирования"/>
    </Grid>
</Page>
