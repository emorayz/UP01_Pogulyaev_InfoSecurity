<Page x:Class="InfoSecurity.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      Title="Диаграммы инцидентов">
    <Grid Margin="12" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Распределение инцидентов по статусам" FontSize="20" FontWeight="Bold" Margin="5"/>
            <WrapPanel HorizontalAlignment="Center">
                <ComboBox x:Name="ChartTypeCombo" Width="220" SelectedIndex="0" ToolTip="Выберите тип диаграммы"
                          SelectionChanged="ChartType_Changed">
                    <ComboBoxItem Content="Столбчатая диаграмма"/>
                    <ComboBoxItem Content="Гистограмма"/>
                    <ComboBoxItem Content="Круговая диаграмма"/>
                    <ComboBoxItem Content="Кольцевая диаграмма"/>
                    <ComboBoxItem Content="Линейный график"/>
                </ComboBox>
                <Button Content="Обновить" ToolTip="Повторно загрузить статистику" Click="Refresh_Click"/>
            </WrapPanel>
        </StackPanel>
        <wfi:WindowsFormsHost Grid.Row="1" Margin="8">
            <charts:Chart x:Name="ChartIncidents"/>
        </wfi:WindowsFormsHost>
    </Grid>
</Page>
